SECRET = your_secret_is_here
PASSWORD_PEPPER=generate_a_random_secret_with_at_least_32_characters
DB_URI = postgresql://user:pwd@host:port/database
HOST= 0.0.0.0
DEBUG= True/False
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
GITHUB_TOKEN=
GITHUB_REPOSITORIES=foxtec198/tmhub,foxtec198/api_tmhub

# Single Sign-On do Jellyfin (OIDC)
OIDC_ISSUER_URL=https://api.tmhub.hubbix.com.br/oidc
OIDC_CLIENT_ID=jellyfin
# Vazio = cliente publico com PKCE S256 obrigatorio. Defina para cliente confidencial.
OIDC_CLIENT_SECRET=
# Prefira a chave PEM codificada em base64 para evitar problemas com multilinha.
OIDC_RSA_PRIVATE_KEY_B64=
# Alternativa legada: OIDC_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OIDC_KEY_ID=tmhub-jellyfin-1
OIDC_REDIRECT_URIS=https://stream.tmhub.hubbix.com.br/sso/OID/redirect/tmhub
JELLYFIN_SSO_START_URL=https://stream.tmhub.hubbix.com.br/sso/OID/start/tmhub
# IDs do TMHub autorizados a receber administracao no Jellyfin. Vazio por padrao.
OIDC_JELLYFIN_ADMIN_USER_IDS=
